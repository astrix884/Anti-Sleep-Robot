import cv2
import mediapipe as mp
from math import hypot
import time
import serial

# ==================================
# SERIAL PORT
# ==================================
ser = serial.Serial(
    'COM3',      # Change to your ESP32 COM port
    115200,
    timeout=1
)

time.sleep(2)

# ==================================
# MEDIAPIPE FACE MESH
# ==================================
mp_face_mesh = mp.solutions.face_mesh

face_mesh = mp_face_mesh.FaceMesh(
    max_num_faces=1,
    refine_landmarks=True,
    min_detection_confidence=0.5,
    min_tracking_confidence=0.5
)

# ==================================
# EYE LANDMARKS
# ==================================
LEFT_EYE = [33, 160, 158, 133, 153, 144]
RIGHT_EYE = [362, 385, 387, 263, 373, 380]

# ==================================
# SETTINGS
# ==================================
EAR_THRESHOLD = 0.28
DROWSY_TIME = 1

eyes_closed_start = None

# ==================================
# EAR FUNCTION
# ==================================
def eye_aspect_ratio(landmarks, eye):

    p1 = landmarks[eye[0]]
    p2 = landmarks[eye[1]]
    p3 = landmarks[eye[2]]
    p4 = landmarks[eye[3]]
    p5 = landmarks[eye[4]]
    p6 = landmarks[eye[5]]

    vertical1 = hypot(p2[0] - p6[0], p2[1] - p6[1])
    vertical2 = hypot(p3[0] - p5[0], p3[1] - p5[1])
    horizontal = hypot(p1[0] - p4[0], p1[1] - p4[1])

    return (vertical1 + vertical2) / (2.0 * horizontal)

# ==================================
# CAMERA
# ==================================
cap = cv2.VideoCapture(0)

while True:

    ret, frame = cap.read()

    if not ret:
        break

    frame = cv2.flip(frame, 1)

    h, w, _ = frame.shape

    center_x = w // 2
    center_y = h // 2

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

    results = face_mesh.process(rgb)

    status = "AWAKE"
    drowsy_flag = 0

    cv2.circle(frame, (center_x, center_y), 6, (0, 0, 255), -1)

    if results.multi_face_landmarks:

        for face_landmarks in results.multi_face_landmarks:

            landmarks = []

            for lm in face_landmarks.landmark:

                x = int(lm.x * w)
                y = int(lm.y * h)

                landmarks.append((x, y))

            # ==================================
            # EAR CALCULATION
            # ==================================
            left_ear = eye_aspect_ratio(
                landmarks,
                LEFT_EYE
            )

            right_ear = eye_aspect_ratio(
                landmarks,
                RIGHT_EYE
            )

            avg_ear = (left_ear + right_ear) / 2

            cv2.putText(
                frame,
                f"EAR: {avg_ear:.3f}",
                (20, 40),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0, 255, 0),
                2
            )

            # ==================================
            # DROWSINESS DETECTION
            # ==================================
            if avg_ear < EAR_THRESHOLD:

                if eyes_closed_start is None:
                    eyes_closed_start = time.time()

                elapsed = time.time() - eyes_closed_start

                if elapsed > DROWSY_TIME:

                    status = "DROWSY!"
                    drowsy_flag = 1

                    cv2.putText(
                        frame,
                        "WAKE UP!",
                        (150, 100),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        1.5,
                        (0, 0, 255),
                        3
                    )

            else:
                eyes_closed_start = None

            # ==================================
            # FACE CENTER
            # ==================================
            left_cheek = landmarks[234]
            right_cheek = landmarks[454]

            face_x = (
                left_cheek[0] +
                right_cheek[0]
            ) // 2

            face_y = (
                left_cheek[1] +
                right_cheek[1]
            ) // 2

            # Draw face center
            cv2.circle(
                frame,
                (face_x, face_y),
                8,
                (255, 0, 0),
                -1
            )

            cv2.line(
                frame,
                (center_x, center_y),
                (face_x, face_y),
                (0, 255, 0),
                2
            )

            # ==================================
            # ERROR VALUES
            # ==================================
            error_x = face_x - center_x
            error_y = face_y - center_y

            cv2.putText(
                frame,
                f"X Error: {error_x}",
                (20, 120),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (255, 255, 0),
                2
            )

            cv2.putText(
                frame,
                f"Y Error: {error_y}",
                (20, 150),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (255, 255, 0),
                2
            )

            # ==================================
            # SERVO ANGLE MAPPING
            # ==================================
            pan_angle = int((face_x / w) * 180)
            tilt_angle = int((face_y / h) * 180)

            pan_angle = max(0, min(180, pan_angle))
            tilt_angle = max(0, min(180, tilt_angle))

            cv2.putText(
                frame,
                f"PAN:{pan_angle}",
                (20, 220),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (0, 255, 0),
                2
            )

            cv2.putText(
                frame,
                f"TILT:{tilt_angle}",
                (20, 250),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (0, 255, 0),
                2
            )

            # ==================================
            # SEND TO ESP32
            # Format:
            # pan,tilt,sleep
            # Example:
            # 95,88,0
            # ==================================
            packet = (
                f"{pan_angle},"
                f"{tilt_angle},"
                f"{drowsy_flag}\n"
            )

            try:
                ser.write(packet.encode())
            except:
                pass

    cv2.putText(
        frame,
        f"Status: {status}",
        (20, 80),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 255, 255),
        2
    )

    cv2.imshow(
        "Face Tracking + Drowsiness Detection",
        frame
    )

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
ser.close()
cv2.destroyAllWindows()
